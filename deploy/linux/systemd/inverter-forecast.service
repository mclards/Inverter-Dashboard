[Unit]
Description=ADSI Inverter Dashboard 2.0 Solar AI Day-Ahead Forecast Microservice
After=network-online.target inverter-server.service
PartOf=inverter.target
RequiresMountsFor=/opt/inverter-dashboard /var/lib/inverter-dashboard
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=inverter
Group=inverter
WorkingDirectory=/opt/inverter-dashboard/backend/engines/forecast
EnvironmentFile=-/etc/default/inverter-dashboard
ExecStart=/opt/inverter-dashboard/venv/bin/python /opt/inverter-dashboard/backend/engines/forecast/ForecastCoreService.py
Restart=always
RestartSec=10
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
LimitNOFILE=65536
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=inverter.target
