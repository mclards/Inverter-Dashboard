[Unit]
Description=ADSI Inverter Dashboard 2.0 go2rtc Live Video WebRTC Streamer
After=network-online.target
PartOf=inverter.target
RequiresMountsFor=/var/lib/inverter-dashboard
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=inverter
Group=inverter
WorkingDirectory=/var/lib/inverter-dashboard/go2rtc
EnvironmentFile=-/etc/default/inverter-dashboard
ExecStartPre=/usr/bin/test -x /usr/local/bin/go2rtc
ExecStartPre=/usr/bin/test -r /var/lib/inverter-dashboard/go2rtc/go2rtc.yaml
ExecStart=/usr/local/bin/go2rtc -config /var/lib/inverter-dashboard/go2rtc/go2rtc.yaml
Restart=always
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
LimitNOFILE=65536
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=inverter.target
