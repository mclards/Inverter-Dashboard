[Unit]
Description=ADSI Inverter Dashboard 2.0 go2rtc Live Video WebRTC Streamer
After=network-online.target
PartOf=inverter.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=inverter
Group=inverter
WorkingDirectory=/var/lib/inverter-dashboard/go2rtc
EnvironmentFile=-/etc/default/inverter-dashboard
ExecStart=/opt/inverter-dashboard/backend/engines/go2rtc/go2rtc -config /var/lib/inverter-dashboard/go2rtc/go2rtc.yaml
Restart=always
RestartSec=5
LimitNOFILE=65536
KillMode=mixed
TimeoutStopSec=10

[Install]
WantedBy=inverter.target
